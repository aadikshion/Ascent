# DEMO mode (default): leave everything empty.
# LIVE mode via explorer API (recommended): set LIVE=1
LIVE=
# Blockscout API base (from Chainstack docs; verify with: curl $EXPLORER_API/tokens)
EXPLORER_API=https://elysium.kinetiq.xyz/api/v2
# Optional raw RPC fallback (Elysium testnet, chain id 99801)
RPC_URL=
TOKENS_FILE=tokens.json
TOKEN_LIMIT=15
MAX_PAGES=40
BUYBACK_POOL_USD=10000
PORT=3000
